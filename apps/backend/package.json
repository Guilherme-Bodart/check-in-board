{
  "name": "@check-in-board/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "echo \"No lint configured for backend yet\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "fastify": "^5.6.2",
    "pino": "^10.1.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@check-in-board/tsconfig": "workspace:*",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
