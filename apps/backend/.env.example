NODE_ENV=development
HOST=0.0.0.0
PORT=3333
SERVICE_NAME=check-in-board-backend
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/check_in_board?schema=public
AUTH_JWT_SECRET=replace-with-at-least-32-characters-for-non-production-dev
RATE_LIMIT_GLOBAL_MAX=120
RATE_LIMIT_GLOBAL_WINDOW=1 minute
RATE_LIMIT_AUTH_MAX=8
RATE_LIMIT_AUTH_WINDOW=1 minute
RATE_LIMIT_WRITE_MAX=30
RATE_LIMIT_WRITE_WINDOW=1 hour
