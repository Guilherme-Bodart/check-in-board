{
  "name": "check-in-board",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "pnpm -r format",
    "dev:web": "pnpm --filter @check-in-board/web dev",
    "build:web": "pnpm --filter @check-in-board/web build",
    "dev:finance-mvp": "pnpm --filter @check-in-board/finance-mvp dev",
    "build:finance-mvp": "pnpm --filter @check-in-board/finance-mvp build",
    "dev:mobile": "pnpm --filter @check-in-board/mobile dev",
    "dev:backend-spring": "cd apps/backend-spring && mvnw.cmd spring-boot:run",
    "test:backend-spring": "cd apps/backend-spring && mvnw.cmd clean test",
    "build:backend-spring": "cd apps/backend-spring && mvnw.cmd clean package"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
